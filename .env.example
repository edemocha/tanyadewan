# Secrets go in .env (gitignored).
# Hosted LLM for the public demo (generate.provider: openai_compatible), e.g. a Groq key:
LLM_API_KEY=

# Only for scripts/push_qdrant.py, which copies the local index to a Qdrant Cloud cluster
# (URL looks like https://xxxx.region.gcp.cloud.qdrant.io:6333):
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
